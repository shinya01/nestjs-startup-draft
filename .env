SWAGGER_TITLE=My Awesome API
SWAGGER_DESCRIPTION=This is the best API sever.
SWAGGER_VERSION=1.0.0
SWAGGER_PORT=8080

AUTH_DISABLE-false


# アプリケーション設定
PORT=3000

# データベース（デフォルトはローカル）
DB_PORT=5432
DB_NAME=myapp

# JWT設定
JWKS_URI=https://your-idp/.well-known/jwks.json
JWT_ISSUER=https://your-idp/
JWT_AUDIENCE=your-client-id
